<template>
	<div class="page">
		<div class="page-header">
			<input class="btn btn-info" type="button" @click="navigateTo('info')" />
		</div>

		<scroll
			class="page-content"
			scroll-y="true"
			bounces="true"
			style="{{ data.content }}"
		>
			<text class="page-title">Own Your Band!</text>

			<div class="card status-card" onclick="refreshConnectionStatus">
				<div class="card-content">
					<text>Connection</text>
					<text class="card-detail">{{ connectionStatus }}</text>
				</div>
			</div>

			<div class="card" onclick="sendHello">
				<div class="card-content">
					<text>Send hello</text>
					<text class="card-detail">{{ sendStatus }}</text>
				</div>
			</div>
		</scroll>
	</div>
</template>

<script>
import { navigateTo } from "../../common/js/routing";
import { getConnectionState, sendMessage } from "../../common/js/connection";

export default {
	data: {
		connectionStatus: "Checking…",
		sendStatus: "Tap to send",
	},
	navigateTo,

	onInit() {
		this.data = this.$app.$def.data;
		this.connection = this.data.connection.instance;

		this.connection.onopen = () => {
			this.connectionStatus = "Connected";
		};
		this.connection.onclose = () => {
			this.connectionStatus = "Disconnected";
		};
		this.connection.onerror = (error) => {
			console.error("interconnect error:", error);
			this.connectionStatus = "Error";
		};

		this.refreshConnectionStatus();
	},

	async refreshConnectionStatus() {
		this.connectionStatus = "Checking…";
		try {
			this.connectionStatus = await getConnectionState(this.connection);
		} catch (error) {
			console.error("failed to read interconnect state:", error);
			this.connectionStatus = "Error";
		}
	},

	async sendHello() {
		this.sendStatus = "Sending…";
		try {
			await sendMessage(this.connection, "hello world");
			this.sendStatus = "Sent";
		} catch (error) {
			console.error("failed to send hello:", error);
			this.sendStatus = "Send failed";
			this.refreshConnectionStatus();
		}
	},
};
</script>

<style>
/* For shared styles  */
@import url("../../common/css/main.css");

/* Page specific */
@import url("./style.css");
</style>
