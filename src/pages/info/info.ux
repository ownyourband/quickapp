<template>
	<div class="page">
		<div class="page-header">
			<input class="btn btn-back" type="button" @click="goBack" />
		</div>

		<scroll
			class="page-content"
			scroll-y="true"
			bounces="true"
			style="{{ data.content }}"
		>
			<text class="page-title">Own Your Band {{ version }}</text>
			<text>This is the info page of Own Your Band quickapp</text>
			<text>Connection status:</text>
			<text>{{ connectionStatus }}</text>
		</scroll>

		<div class="page-footer">
			<input
				class="btn btn-blue btn-debug"
				type="button"
				@click="navigateTo('debug')"
			/>
		</div>
	</div>
</template>

<script>
import { navigateTo, goBack } from "../../common/js/routing";
import app from "@system.app";
import { getConnectionState } from "../../common/js/connection";

export default {
	data: {
		version: app.getInfo().versionName,
		connectionStatus: "Checking…",
	},
	navigateTo,
	goBack,

	async onInit() {
		Object.assign(this, this.$app.$def);
		try {
			this.connectionStatus = await getConnectionState(
				this.data.connection.instance
			);
		} catch (error) {
			console.error("failed to read interconnect state:", error);
			this.connectionStatus = "Error";
		}
	},
};
</script>

<style>
/* For shared styles  */
@import url("../../common/css/main.css");

/* Page specific */
@import url("./style.css");
</style>
